[Unit]
Description=Novanas Backup Server
After=syslog.target
After=network.target

[Service]
Type=simple
User=novanas
Group=novanas
EnvironmentFile=-/var/novanas/backup-server.env
ExecStart=/usr/local/bin/rest-server --path $BACKUP_PATH --no-auth --listen 127.0.0.1:8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
